# RocketRide configuration
# The VSCode extension will populate ROCKETRIDE_URI and ROCKETRIDE_APIKEY
# into .env from its settings. You can also fill .env manually.

ROCKETRIDE_URI=https://cloud.rocketride.ai
ROCKETRIDE_APIKEY=your-api-key-here

# Custom variables referenced in .pipe files via ${ROCKETRIDE_*} get listed here:
# ROCKETRIDE_INPUT_PATH=
# ROCKETRIDE_OUTPUT_PATH=
